# Copy to .env.local and fill in. Nothing here is required: without keys the demo runs on templates in the browser.

# Language model (PRD 14). Server only, never exposed to the browser. Inputs are always masked first.
LLM_PROVIDER=gemini                 # gemini (free tier) | anthropic | none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash       # writer and consolidator in the review loop
GEMINI_MODEL_FAST=gemini-3.5-flash-lite  # reviewer, review tagging, offer lint
LLM_MODEL=claude-sonnet-5-5         # Anthropic writer
LLM_MODEL_FAST=claude-haiku-5-5     # Anthropic reviewer and classifiers
LLM_API_KEY=
LLM_USE_DEMO_CACHE=true             # serve outputs baked by `pnpm bake:llm`

# Sync: "local" runs the demo in each browser; "server" shares one session across devices.
NEXT_PUBLIC_SYNC=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only

# Sarvam AI: regional languages and voice (translate, Bulbul text to speech, Saaras speech to text).
# Server only; put the real key in .env (git-ignored). Without it the app shows Hindi, Hinglish or English
# and uses the browser's voice. With only this key, Sarvam 105B is also the chat model (SARVAM_MODEL to change).
SARVAM_API_KEY=
