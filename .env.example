# Copy to .env.local and fill in. Nothing here is required: without keys the demo runs on templates in the browser.

# Language model (PRD 14). Server only, never exposed to the browser.
LLM_PROVIDER=anthropic              # anthropic | none
LLM_MODEL=claude-sonnet-5-5         # reminders, case summaries, merchant alerts
LLM_MODEL_FAST=claude-haiku-5-5     # review tagging, question intake, offer lint
LLM_API_KEY=sk-ant-api03-fEwX_c-cIqW6iK2DqG-u_s33644O5-hY07Yv-H_q61_jG-h2m3G-m3B_u3iH-H_c3k4I_x3k4
LLM_USE_DEMO_CACHE=true             # serve outputs baked by `pnpm bake:llm`

# Sync: "local" runs the demo in each browser; "server" shares one session across devices.
NEXT_PUBLIC_SYNC=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only
